---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const base = '/images/projects/moodboard';

// The six finished screens, captured live from the shipped React app.
const screens = [
  { src: `${base}/moodboard-01-hero.png`,        name: 'Landing',        note: 'The promise in one line — “Your pieces don’t talk to each other.”' },
  { src: `${base}/moodboard-02-upload.png`,       name: 'Upload',         note: 'Any photo works. Messy is fine — we read colour and structure, not tidiness.' },
  { src: `${base}/moodboard-03-budgetstyle.png`,  name: 'Budget + Style', note: 'Budget slider first, style tiles second. The core design decision, made visible.' },
  { src: `${base}/moodboard-04-loading.png`,      name: 'Generating',     note: 'A named, multi-step pipeline — the wait is the feature, not a spinner.' },
  { src: `${base}/moodboard-05-results.png`,      name: 'Results',        note: 'Transformed room on the left, a real shoppable product list on the right.' },
  { src: `${base}/moodboard-06-save.png`,         name: 'Save',           note: 'Take it with you — PDF, shareable link, or a before/after image for socials.' },
];

// User journey map — emotion arc + the opportunity each stage opened.
// Pulled straight from the hackathon UX research doc (3 personas + journey map).
const journey = [
  { stage: 'Trigger',        emoji: '😩', emotion: 'Frustrated',   score: 2,  color: '#9AA0A6', note: 'No starting point — “it just feels wrong.”' },
  { stage: 'Discover',       emoji: '🤔', emotion: 'Curious',      score: 4,  color: '#5BA4CF', note: 'Trust barrier — prove it’s not a gimmick, fast.' },
  { stage: 'Upload',         emoji: '😅', emotion: 'Anxious',      score: 3,  color: '#C5AEED', note: 'Photo anxiety — signal “messy is fine.”' },
  { stage: 'Budget + Style', emoji: '😌', emotion: 'Engaged',      score: 6,  color: '#4CAF72', note: 'Decision fatigue — budget filter before style.' },
  { stage: 'Generating',     emoji: '😯', emotion: 'Anticipating', score: 7,  color: '#F5D030', note: 'Dead time — name each step so the wait feels earned.' },
  { stage: 'Results',        emoji: '🤩', emotion: 'Delighted',    score: 10, color: '#F4724A', note: 'Reality gap — composite into their real room.', peak: true },
  { stage: 'Save & Share',   emoji: '😊', emotion: 'Confident',    score: 9,  color: '#F2A0BC', note: 'Action gap — save-for-later is the real CTA.' },
];
const jPad = 50, jStep = 100;
const jPts = journey.map((d, i) => ({ x: jPad + i * jStep, y: 95 - d.score * 7.5 }));
const jLine = jPts.map(p => `${p.x},${p.y}`).join(' ');
const jArea = `M ${jPts[0].x},100 ` + jPts.map(p => `L ${p.x},${p.y}`).join(' ') + ` L ${jPts[jPts.length - 1].x},100 Z`;
---

<BaseLayout title="MoodBoard — Dianne Ting">
  <Header />

  <main>

    <!-- ─── BACK NAV ──────────────────────────────────────────────── -->
    <div class="px-8 md:px-16 lg:px-24 pt-24 md:pt-32 pb-0">
      <a href="/work" class="inline-flex items-center gap-2 text-sm hover:text-accent transition-colors" style="color:#999;" data-hover>
        ← <span class="en-text">All Work</span><span class="zh-text">全部作品</span>
      </a>
    </div>

    <!-- English-only notice (shown in Chinese mode only) -->
    <div class="zh-text px-8 md:px-16 lg:px-24 mt-4">
      <span class="text-xs" style="color:#bbb;">本案例研究以英文呈現</span>
    </div>

    <!-- ─── HERO ──────────────────────────────────────────────────── -->
    <section class="px-8 md:px-16 lg:px-24 pt-12 pb-16 md:pb-24">
      <div class="max-w-4xl">

        <div class="flex flex-wrap items-center gap-2 mb-6 reveal">
          <span class="tag">Hackathon</span>
          <span class="tag">UX Research</span>
          <span class="tag">Design System</span>
          <span class="tag">React</span>
          <span class="tag-win">🏆 1st Place · Apify Prize</span>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-8xl font-light leading-none tracking-tight mb-6 reveal" style="transition-delay:0.1s">MoodBoard</h1>

        <p class="text-xl md:text-2xl font-light leading-relaxed max-w-2xl reveal" style="color:#555; transition-delay:0.2s">
          Upload a photo of your room, set a budget, tap a few style tiles — and get your <em>actual</em> space transformed, with a real, shoppable product list sourced live from the web. Built in 17 hours, as a team of four.
        </p>

        <div class="flex flex-wrap gap-x-10 gap-y-6 mt-12 reveal" style="transition-delay:0.3s">
          <div>
            <div class="text-xs font-medium tracking-widest uppercase mb-1" style="color:#999;">Role</div>
            <div class="text-sm font-medium">Sole Designer — UX Research, Design System, Frontend</div>
          </div>
          <div>
            <div class="text-xs font-medium tracking-widest uppercase mb-1" style="color:#999;">Team</div>
            <div class="text-sm font-medium">4 people</div>
          </div>
          <div>
            <div class="text-xs font-medium tracking-widest uppercase mb-1" style="color:#999;">Timeline</div>
            <div class="text-sm font-medium">17 hours · May 29–30, 2026</div>
          </div>
          <div>
            <div class="text-xs font-medium tracking-widest uppercase mb-1" style="color:#999;">Event</div>
            <div class="text-sm font-medium">Cascadia AI Hackathon · thinkspace, Seattle</div>
          </div>
          <div>
            <div class="text-xs font-medium tracking-widest uppercase mb-1" style="color:#999;">Live Demo</div>
            <div class="text-sm font-medium">
              <a href="https://moodboard-wine.vercel.app" target="_blank" rel="noopener" class="demo-link" data-hover>moodboard-wine.vercel.app →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── HERO SCREENSHOT ───────────────────────────────────────── -->
    <section class="px-8 md:px-16 lg:px-24 pb-20 md:pb-28">
      <div class="screen-card hero-shot reveal" style="transition-delay:0.1s">
        <img src={`${base}/moodboard-01-hero.png`} alt="MoodBoard landing screen — Warm Studio design system" loading="lazy" />
      </div>
    </section>

    <!-- ─── DIVIDER ───────────────────────────────────────────────── -->
    <div class="px-8 md:px-16 lg:px-24"><div style="height:1px; background:rgba(0,0,0,0.06);"></div></div>

    <!-- ─── METRICS ──────────────────────────────────────────────── -->
    <section class="px-8 md:px-16 lg:px-24 py-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl reveal">
        <div class="metric-card">
          <div class="metric-value">17<span class="metric-unit">hrs</span></div>
          <div class="metric-label">Idea to working product</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">6</div>
          <div class="metric-label">Screens designed & shipped</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">12<span class="metric-unit">/54</span></div>
          <div class="metric-label">Overall placing</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">$500</div>
          <div class="metric-label">1st place · Apify Prize</div>
        </div>
      </div>
    </section>

    <!-- ─── DIVIDER ───────────────────────────────────────────────── -->
    <div class="px-8 md:px-16 lg:px-24"><div style="height:1px; background:rgba(0,0,0,0.06);"></div></div>

    <!-- ─── THE PROBLEM ──────────────────────────────────────────── -->
    <section class="px-8 md:px-16 lg:px-24 py-20 md:py-28">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-8 reveal">
          <div class="w-1.5 h-1.5 rounded-full bg-accent"></div>
          <span class="text-xs font-medium tracking-widest uppercase" style="color:#999;">The Problem</span>
        </div>

        <blockquote class="text-2xl md:text-3xl font-light leading-relaxed mb-10 reveal" style="transition-delay:0.1s; color:#111; border-left:3px solid var(--accent); padding-left:1.5rem;">
          Finding furniture that actually fits — your space, your style, your budget — means hours lost in an ocean of online options. And the tools that promise to help either ignore the budget, or leave you with a pretty picture and no way to actually buy.
        </blockquote>

        <p class="text-base leading-relaxed mb-6 reveal" style="color:#555; transition-delay:0.2s">
          We’re all renters — so this was a pain we’d each lived, not one we imagined. Whether you’re filling an empty room from scratch or working around furniture you already own, it breaks at three distinct points. MoodBoard was built to close all three at once.
        </p>

        <div class="gap-grid reveal" style="transition-delay:0.25s">
          <div class="gap-item">
            <div class="gap-num">01</div>
            <div class="gap-title">Starting from nothing</div>
            <p class="gap-body">IKEA alone carries thousands of products; Wayfair, millions. Without a visual direction, every choice feels like it could be wrong — so people impulse-buy or stall.</p>
          </div>
          <div class="gap-item">
            <div class="gap-num">02</div>
            <div class="gap-title">Budget</div>
            <p class="gap-body">Existing tools render a redesigned room. None search for <em>actual purchasable products</em> that fit a real budget. The gap between inspiration and action stays exactly where it was.</p>
          </div>
          <div class="gap-item">
            <div class="gap-num">03</div>
            <div class="gap-title">Coherence</div>
            <p class="gap-body">People who furnished piece by piece end up with rooms that feel random — not bad taste, just each purchase made in isolation. The room has no thread.</p>
          </div>
        </div>

        <p class="text-base leading-relaxed mt-10 reveal" style="color:#555; transition-delay:0.3s">
          MoodBoard searches the web in real time for products that match the user’s style and budget, composites them into a photo of their actual room, and delivers a prioritised shopping list they can act on immediately.
        </p>
      </div>
    </section>

    <!-- ─── DIVIDER ───────────────────────────────────────────────── -->
    <div class="px-8 md:px-16 lg:px-24"><div style="height:1px; background:rgba(0,0,0,0.06);"></div></div>

    <!-- ═══ TIMELINE WRAP (01–05, the 17-hour build clock) ═══════════ -->
    <div class="timeline">

    <!-- ─── 01 RESEARCH ───────────────────────────────────────────── -->
    <section class="px-8 md:px-16 lg:px-24 py-20 md:py-28">
      <div class="max-w-3xl mb-12 reveal">
        <div class="time-mark"><span class="time-when">Fri · 8:00 PM</span><span class="time-elapsed">hour 0</span></div>
        <div class="flex items-center gap-3 mb-8">
          <span class="section-num">01</span>
          <span class="text-xs font-medium tracking-widest uppercase" style="color:#999;">Two Hours of Research, Three User Types</span>
        </div>
        <p class="text-base leading-relaxed mb-6" style="color:#555;">
          The idea was locked at 8pm. The venue closed at 10pm. Those two hours went to research — first a fast scan of existing tools to pin down the gap (they render a pretty room, but none shop it to a real budget), then the real depth into the people. Three personas, built around the users who actually redecorate on a real budget.
        </p>
        <p class="text-base leading-relaxed" style="color:#555;">
          Different situations, different stakes — but one shared problem: not a lack of taste, but too much noise. All three needed the field narrowed, fast, to things that would actually work together in their specific space.
        </p>
      </div>

      <!-- Three persona cards -->
      <div class="persona-grid reveal" style="transition-delay:0.15s">
        <div class="persona-card" style="--pc:#F4724A;">
          <div class="persona-head">
            <div class="persona-tag">Persona 1 · Existing renter</div>
            <div class="persona-name">Alex <span>· 28</span></div>
            <div class="persona-context">Remote worker · 1-bed · furnished piecemeal over 2 years</div>
          </div>
          <div class="persona-budget"><span>Budget</span><strong>$350</strong></div>
          <div class="persona-quote">“Give me suggestions. Don’t tell me to prompt it — I usually don’t know what I want.”</div>
          <div class="persona-block">
            <div class="persona-block-label">Goals</div>
            <ul class="persona-list">
              <li>Make the room feel cohesive — pieces that belong together</li>
              <li>A saved plan to shop from gradually, not all at once</li>
              <li>Discover taste by <em>seeing</em> it, not describing it</li>
            </ul>
          </div>
          <div class="persona-block">
            <div class="persona-block-label">Pain points</div>
            <ul class="persona-list pains">
              <li>Bought pieces separately — the room feels random</li>
              <li>Can’t translate Pinterest into a real decision</li>
              <li>Loses track of spend across shopping sessions</li>
            </ul>
          </div>
        </div>

        <div class="persona-card" style="--pc:#5BA4CF;">
          <div class="persona-head">
            <div class="persona-tag">Persona 2 · New mover</div>
            <div class="persona-name">Jordan <span>· 26</span></div>
            <div class="persona-context">First solo apartment · moved from shared housing · mostly empty</div>
          </div>
          <div class="persona-budget"><span>Budget</span><strong>$600</strong></div>
          <div class="persona-quote">“I don’t even know where to start. The room is just… blank.”</div>
          <div class="persona-block">
            <div class="persona-block-label">Goals</div>
            <ul class="persona-list">
              <li>A starting kit — the essential 6–10 pieces</li>
              <li>Commit to a style they won’t regret in 6 months</li>
              <li>A clear spend order — what to buy first</li>
            </ul>
          </div>
          <div class="persona-block">
            <div class="persona-block-label">Pain points</div>
            <ul class="persona-list pains">
              <li>Blank-canvas paralysis — nothing to anchor from</li>
              <li>Fear of style regret — can’t commit unseen</li>
              <li>Urgency + overwhelm — buying fast = random room</li>
            </ul>
          </div>
        </div>

        <div class="persona-card" style="--pc:#C5AEED;">
          <div class="persona-head">
            <div class="persona-tag">Persona 3 · Student / new grad</div>
            <div class="persona-name">Maya <span>· 21</span></div>
            <div class="persona-context">First real apartment · shops IKEA, Marketplace, thrift</div>
          </div>
          <div class="persona-budget"><span>Budget</span><strong>$120</strong></div>
          <div class="persona-quote">“I want it to look curated, not cheap. But I literally have $120.”</div>
          <div class="persona-block">
            <div class="persona-block-label">Goals</div>
            <ul class="persona-list">
              <li>Look intentional and curated — not budget</li>
              <li>Pieces under $30 — IKEA, thrift, or dupes</li>
              <li>A shareable “room makeover” moment</li>
            </ul>
          </div>
          <div class="persona-block">
            <div class="persona-block-label">Pain points</div>
            <ul class="persona-list pains">
              <li>Tools always recommend things out of budget</li>
              <li>Style exists, execution doesn’t — can’t afford it</li>
              <li>Feels excluded — “this tool isn’t for me”</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="max-w-3xl mt-12 reveal" style="transition-delay:0.25s">
        <p class="text-base leading-relaxed" style="color:#555;">
          That finding anchored every subsequent decision: <strong>no open text inputs</strong>. Every choice had to be visual, bounded, and immediately actionable.
        </p>
      </div>

      <!-- Journey map -->
      <div class="max-w-3xl mt-16 mb-10 reveal">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1.5 h-1.5 rounded-full bg-accent"></div>
          <span class="text-xs font-medium tracking-widest uppercase" style="color:#999;">User Journey Map</span>
        </div>
        <p class="text-base leading-relaxed" style="color:#555;">
          As a team, we first talked through the flow and pulled out the screens we’d need and what each one had to do. From there, I used the personas and this map to pin down the emotion at every step in detail — and made it my guide for the design that followed. Every later decision — budget-first, the named loading screen, the composited “your actual room” reveal — traces back to a stage on this map.
        </p>
      </div>

      <div class="journey reveal" style="transition-delay:0.1s">
        <svg class="journey-curve" viewBox="0 0 700 100" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="jgrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="rgba(244,114,74,0.22)" />
              <stop offset="1" stop-color="rgba(244,114,74,0)" />
            </linearGradient>
          </defs>
          <path d={jArea} fill="url(#jgrad)" />
          <polyline points={jLine} fill="none" stroke="#F4724A" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" />
        </svg>
        <div class="journey-cols">
          {journey.map((d) => (
            <div class={`journey-col${d.peak ? ' is-peak' : ''}`} style={`--jc:${d.color}`}>
              <div class="journey-emoji">{d.emoji}</div>
              <div class="journey-stage">{d.stage}</div>
              <div class="journey-emotion">{d.emotion}</div>
              <div class="journey-note">{d.note}</div>
              {d.peak && <div class="journey-peak-tag">★ Emotional peak</div>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── DIVIDER ───────────────────────────────────────────────── -->
    <div class="px-8 md:px-16 lg:px-24"><div style="height:1px; background:rgba(0,0,0,0.06);"></div></div>

    <!-- ─── 02 DESIGN DIRECTION ──────────────────────────────────── -->
    <section class="px-8 md:px-16 lg:px-24 py-20 md:py-28">
      <div class="max-w-3xl mb-12 reveal">
        <div class="time-mark"><span class="time-when">Fri · ~Midnight</span><span class="time-elapsed">hour 4</span></div>
        <div class="flex items-center gap-3 mb-8">
          <span class="section-num">02</span>
          <span class="text-xs font-medium tracking-widest uppercase" style="color:#999;">The Design Direction, Decided at Midnight</span>
        </div>
        <p class="text-base leading-relaxed mb-6" style="color:#555;">
          Most AI design tools cluster around two visual modes: clean SaaS grey, or professional-grade dark-mode tools dense with controls. Both say the same thing implicitly — <em>this tool is for people who already know what they’re doing.</em>
        </p>
        <p class="text-base leading-relaxed" style="color:#555;">
          The persona research had made the target user clear: someone overwhelmed by too many choices, not someone who needed more professional controls. So the direction landed deliberately opposite — warm, encouraging, a little playful. I named the system <strong>Warm Studio</strong>.
        </p>
      </div>

      <blockquote class="design-quote reveal" style="transition-delay:0.15s">
        The interface should feel like a knowledgeable friend, not an interior design tool.
      </blockquote>
    </section>

    <!-- ─── DIVIDER ───────────────────────────────────────────────── -->
    <div class="px-8 md:px-16 lg:px-24"><div style="height:1px; background:rgba(0,0,0,0.06);"></div></div>

    <!-- ─── 03 DESIGN SYSTEM ─────────────────────────────────────── -->
    <section class="warm-section px-8 md:px-16 lg:px-24 py-20 md:py-28">
      <div class="max-w-3xl mb-12 reveal">
        <div class="time-mark"><span class="time-when">Sat · Morning</span><span class="time-elapsed">hour 12</span></div>
        <div class="flex items-center gap-3 mb-8">
          <span class="section-num">03</span>
          <span class="text-xs font-medium tracking-widest uppercase" style="color:#999;">System Before Screens — “Warm Studio”</span>
        </div>
        <p class="text-base leading-relaxed mb-6" style="color:#555;">
          The next morning, before a single screen was designed, I built the design system. In a team of four under time pressure, a design system isn’t optional — it’s the communication layer. With it, the rules are already made and engineers can move in parallel without waiting on design.
        </p>
        <p class="text-base leading-relaxed" style="color:#555;">
          Cream backgrounds instead of white. Heavy DM Sans — bold enough to feel confident, rounded enough to stay approachable. Organic colour blobs used sparingly: personality, not decoration.
        </p>
      </div>

      <!-- Colour palette -->
      <div class="warm-palette-card reveal" style="transition-delay:0.15s">
        <div class="warm-palette">
          <div class="warm-swatch"><span class="warm-blob" style="background:#F4724A;"></span><span class="warm-name">Coral</span><span class="warm-hex">#F4724A</span></div>
          <div class="warm-swatch"><span class="warm-blob" style="background:#F2A0BC;"></span><span class="warm-name">Pink</span><span class="warm-hex">#F2A0BC</span></div>
          <div class="warm-swatch"><span class="warm-blob" style="background:#4CAF72;"></span><span class="warm-name">Green</span><span class="warm-hex">#4CAF72</span></div>
          <div class="warm-swatch"><span class="warm-blob" style="background:#5BA4CF;"></span><span class="warm-name">Blue</span><span class="warm-hex">#5BA4CF</span></div>
          <div class="warm-swatch"><span class="warm-blob" style="background:#F5D030;"></span><span class="warm-name">Yellow</span><span class="warm-hex">#F5D030</span></div>
          <div class="warm-swatch"><span class="warm-blob" style="background:#C5AEED;"></span><span class="warm-name">Lavender</span><span class="warm-hex">#C5AEED</span></div>
          <div class="warm-swatch"><span class="warm-blob warm-blob-light" style="background:#F4F1EC;"></span><span class="warm-name">Canvas</span><span class="warm-hex">#F4F1EC</span></div>
          <div class="warm-swatch"><span class="warm-blob" style="background:#1C1C1C;"></span><span class="warm-name">Ink</span><span class="warm-hex">#1C1C1C</span></div>
        </div>
      </div>

      <!-- System facts -->
      <div class="warm-facts reveal" style="transition-delay:0.2s">
        <div class="warm-fact"><div class="warm-fact-num">11</div><div class="warm-fact-label">Design tokens — 6 accents, 5 neutrals</div></div>
        <div class="warm-fact"><div class="warm-fact-num">DM Sans</div><div class="warm-fact-label">One typeface, weights 400–900</div></div>
        <div class="warm-fact"><div class="warm-fact-num">Copy-paste</div><div class="warm-fact-label">Tokens written to drop straight into global CSS</div></div>
      </div>

      <!-- Budget-first decision callout -->
      <div class="max-w-3xl mt-16 mb-8 reveal">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1.5 h-1.5 rounded-full" style="background:#F4724A;"></div>
          <span class="text-xs font-medium tracking-widest uppercase" style="color:#999;">The Most Deliberate Decision</span>
        </div>
        <p class="text-base leading-relaxed" style="color:#555;">
          The sharpest call in the system wasn’t a colour or a typeface — it was the <strong>sequence of inputs</strong> on the Budget + Style screen.
        </p>
      </div>

      <div class="decision-callout reveal" style="transition-delay:0.1s">
        <div class="decision-callout-inner">
          <div class="decision-col">
            <div class="decision-col-label">The decision</div>
            <div class="decision-col-body">Budget slider first. Style tiles second. Always in that order.</div>
          </div>
          <div class="decision-divider"></div>
          <div class="decision-col">
            <div class="decision-col-label">Why</div>
            <div class="decision-col-body">For all three personas, budget is the real constraint — not style. Seeing style before anchoring to a number is window shopping: it builds desire before checking reality.</div>
          </div>
          <div class="decision-divider"></div>
          <div class="decision-col">
            <div class="decision-col-label">For Maya especially</div>
            <div class="decision-col-body">Budget-first is a respect signal — this tool knows you have limits, and it’s working within them from the start.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── DIVIDER ───────────────────────────────────────────────── -->
    <div class="px-8 md:px-16 lg:px-24"><div style="height:1px; background:rgba(0,0,0,0.06);"></div></div>

